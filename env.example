# 复制本文件为 .env ，填写自己电脑的 SQL Server 连接信息
# 默认 SQL Server 身份验证；请先运行 setup_web_login.sql 创建低权限数据库账号
SQL_SERVER=localhost
SQL_DATABASE=CampusEVPlatformDB
SQL_DRIVER=ODBC Driver 18 for SQL Server

SQL_AUTH_MODE=sql
SQL_USERNAME=campus_ev_web
SQL_PASSWORD=请填写setup_web_login.sql中设置的强密码

# 本机开发环境允许信任自签名证书。校园正式部署需使用有效证书及 TLS
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=yes

# 正式部署建议填写随机 32 字节以上密钥；留空则每次启动随机生成（重启后需要重新登录）
FLASK_SECRET_KEY=
COOKIE_SECURE=no
PORT=5000
